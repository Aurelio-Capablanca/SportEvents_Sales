<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PublicMaster.Master.cs" Inherits="SportEvents_Sales_Front_End.View.Public.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ticket Sales Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="#">TicketHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">See Tickets</a></li>
                    <%--<li class="nav-item"><a class="nav-link" href="#">Login</a></li>--%>
                    <li class="nav-item">

                        <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">Login</a>

                        <%--<button class="btn btn-warning mt-4" data-bs-toggle="modal" data-bs-target="#loginModal">
                        Login
                    </button>--%>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="#">Cart <span class="badge bg-primary">0</span></a></li>
                </ul>
            </div>
        </div>
    </nav>
    <%-- end --%>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
         <!-- Login Page (Modal) -->
        <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Login</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <asp:TextBox runat="server" class="form-control" ID="txtEmail"></asp:TextBox>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <asp:TextBox runat="server" class="form-control" ID="txtPassword"></asp:TextBox>
                            </div>
                            <%--<button type="button" class="btn btn-primary" id="login_trigger">Login</button>--%>
                            <asp:Button class="btn btn-primary" ID="login_trigger" runat="server" OnClick="LoginButton_Click" OnClientClick="return false;" Text="Login" />
                            <asp:Label ID="lblLoginMessage" runat="server" CssClass="fw-bold d-block mb-3 text-center">message</asp:Label>
                            <%--Login--%>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
